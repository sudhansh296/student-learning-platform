# Site URL used for sitemap generation, canonical links and structured data
# Set this to your production domain on Vercel/Railway
NEXT_PUBLIC_SITE_URL=https://webdevatlas.com

# Public contact address shown on /contact and in the Privacy Policy and Terms (replace the placeholder with a real mailbox)
NEXT_PUBLIC_CONTACT_EMAIL=contact@webdevatlas.com

# Google AdSense publisher id, e.g. ca-pub-1234567890123456. Leave empty until your AdSense account exists.
# When set: the ownership meta tag, /ads.txt and the ad script (content pages only) turn on and the CSP allows Google's ad domains.
# It is read at build time, so rebuild / redeploy after changing it.
NEXT_PUBLIC_ADSENSE_CLIENT=

# Google Search Console ownership verification code (Search Console → Settings → Ownership verification → HTML tag method →
# copy only the "content" value from <meta name="google-site-verification" content="THIS_PART" />, not the whole tag).
# Leave empty until you add the property in Search Console. Read at build time, so rebuild / redeploy after changing it.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
